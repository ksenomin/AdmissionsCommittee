@using AdmissionComitte.Web.Controllers
@using AdmissionComittee.Entities
@model AdmissionComittee.Entities.Applicant?

@{
    ViewData["Title"] = "Добавить студента";
    var pageType = Model?.Id is null ? nameof(HomeController.Create) : nameof(HomeController.Update);
}
@if (Model?.Id is null)
{
    <h2 class="mb-3">Добавить студента</h2>
}
else
{
    <h2 class="mb-3">Обновить студента</h2>
}

<form asp-action="@pageType" method="post" class="w-50">
    <input asp-for="Id" class="form-control" hidden="hidden"/>

    <div class="mb-2">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control"/>
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Gender"></label>
        <select asp-for="Gender"
                asp-items="Html.GetEnumSelectList<Gender>()"
                class="form-select">
        </select>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="BirthDay"></label>
        <input asp-for="BirthDay" type="date" class="form-control"/>
        <span asp-validation-for="BirthDay" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label asp-for="StudyForm"></label>
        <select asp-for="StudyForm"
                asp-items="Html.GetEnumSelectList<StudyForm>()"
                class="form-select">
        </select>
        <span asp-validation-for="StudyForm" class="text-danger"></span>
    </div>

    <div class="row mb-2">
        <div class="col">
            <label asp-for="MathScore"></label>
            <input asp-for="MathScore" type="number" class="form-control"/>
            <span asp-validation-for="MathScore" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="RussianScore"></label>
            <input asp-for="RussianScore" type="number" class="form-control"/>
            <span asp-validation-for="RussianScore" class="text-danger"></span>
        </div>
        <div class="col">
            <label asp-for="InformaticScore"></label>
            <input asp-for="InformaticScore" type="number" class="form-control"/>
            <span asp-validation-for="InformaticScore" class="text-danger"></span>
        </div>
    </div>

    <button class="btn btn-success">Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}

